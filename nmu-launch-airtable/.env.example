# Copy this file to .env.local (never commit it) and fill in the values.
# On AWS Amplify, add the same names under App settings → Environment variables.

# Airtable personal access token. Scopes: data.records:read, data.records:write.
# Access: only the NMU base this app uses.
AIRTABLE_TOKEN=

# Base ID from the base's URL (starts with "app").
AIRTABLE_BASE_ID=

# Optional. If set, visitors are asked for this code once per browser before the app loads data.
APP_PASSCODE=
