# Copy this file to .env (never commit .env) and fill in the values.
# In Vercel, add the same two names under Project → Settings → Environment Variables.

# Airtable personal access token. Scopes: data.records:read, data.records:write.
# Access: only the NMU base this app uses.
AIRTABLE_TOKEN=

# Base ID from the base's URL (starts with "app").
AIRTABLE_BASE_ID=
